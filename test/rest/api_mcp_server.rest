###
@opration_datetime = {{$localDatetime "YYYY/MM/DD HH:mm:ss"}}

###
# @name maintenance_all_register
# ツール "maintenance-all" を呼び出し、レコードを新規登録します(tools/call)
# ※ parameterの内容は対象メニューの実際の項目(column_name_rest)に合わせて指定してください
POST {{base_org_url}}/api/{{organization_id}}/workspaces/{{workspace_id}}/mcp
Authorization: Basic {{org-user-id}} {{org-user-pw}}
content-type: application/json

{
  "jsonrpc": "2.0",
  "id": 1,
  "method": "tools/call",
  "params": {
    "name": "maintenance-all",
    "arguments": {
      "menu": "operation_list",
      "records": [
        {
          "type": "Register",
          "parameter": {
            "operation_name": "Operation {{opration_datetime}}",
            "scheduled_date_for_execution": "{{opration_datetime}}"
          }
        }
      ]
    }
  }
}

###
# @name create_menu
# ツール "create-menu" を呼び出し、新規のパラメータシート(メニュー)を作成します(tools/call)
# ※ {{$timestamp}} はリクエストの度に再評価されるため、実際に作成されたmenu_name_restは
#   create_menuのレスポンスから取得して以降のリクエストで使用する
POST {{base_org_url}}/api/{{organization_id}}/workspaces/{{workspace_id}}/mcp
Authorization: Basic {{org-user-id}} {{org-user-pw}}
content-type: application/json

{
  "jsonrpc": "2.0",
  "id": 1,
  "method": "tools/call",
  "params": {
    "name": "create-menu",
    "arguments": {
      "menu_definition": {
        "menu": {
          "menu_name": "AI Test Parameter Sheet {{$timestamp}}",
          "menu_name_rest": "ai_test_param_sheet_{{$timestamp}}",
          "description": "A simple parameter sheet created by the create-menu tool test",
          "sheet_type_id": "1",
          "hostgroup": "0",
          "vertical": "0"
        },
        "column": {
          "c1": {
            "item_name": "A text field",
            "item_name_rest": "a_text_field",
            "required": "1",
            "column_class": "SingleTextColumn",
            "single_string_maximum_bytes": "256"
          }
        }
      }
    }
  }
}

###
@menu_create_rest_name = {{create_menu.response.body.$.result.structuredContent.result.data.menu_name_rest}}

###
# @name get_menu_definition
# ツール "get-menu-definition" を呼び出し、作成したパラメータシートの定義情報を取得します(tools/call)
POST {{base_org_url}}/api/{{organization_id}}/workspaces/{{workspace_id}}/mcp
Authorization: Basic {{org-user-id}} {{org-user-pw}}
content-type: application/json

{
  "jsonrpc": "2.0",
  "id": 1,
  "method": "tools/call",
  "params": {
    "name": "get-menu-definition",
    "arguments": {
      "menu_rest_name": "{{menu_create_rest_name}}"
    }
  }
}

###
@menu_create_id = {{get_menu_definition.response.body.$.result.structuredContent.result.menu_definition.menu.menu_create_id}}
@menu_create_update_at = {{get_menu_definition.response.body.$.result.structuredContent.result.menu_definition.menu.last_update_date_time}}
@menu_create_role_list = {{get_menu_definition.response.body.$.result.structuredContent.result.menu_definition.menu.role_list}}
@menu_create_column_id = {{get_menu_definition.response.body.$.result.structuredContent.result.menu_definition.column.c1.create_column_id}}
@menu_create_column_update_at = {{get_menu_definition.response.body.$.result.structuredContent.result.menu_definition.column.c1.last_update_date_time}}

###
# ツール "update-menu" を呼び出し、作成したパラメータシートの説明を更新します(tools/call)
POST {{base_org_url}}/api/{{organization_id}}/workspaces/{{workspace_id}}/mcp
Authorization: Basic {{org-user-id}} {{org-user-pw}}
content-type: application/json

{
  "jsonrpc": "2.0",
  "id": 1,
  "method": "tools/call",
  "params": {
    "name": "update-menu",
    "arguments": {
      "menu_definition": {
        "menu": {
          "menu_create_id": "{{menu_create_id}}",
          "menu_name": "AI Test Parameter Sheet Update {{$timestamp}}",
          "menu_name_rest": "{{menu_create_rest_name}}",
          "description": "A simple parameter sheet updated by the update-menu tool test",
          "sheet_type_id": "1",
          "hostgroup": "0",
          "vertical": "0",
          "last_update_date_time": "{{menu_create_update_at}}",
          "role_list": {{menu_create_role_list}}
        },
        "column": {
          "c1": {
            "create_column_id": "{{menu_create_column_id}}",
            "last_update_date_time": "{{menu_create_column_update_at}}",
            "item_name": "A text field",
            "item_name_rest": "a_text_field",
            "required": "1",
            "column_class": "SingleTextColumn",
            "single_string_maximum_bytes": "256"
          }
        }
      }
    }
  }
}


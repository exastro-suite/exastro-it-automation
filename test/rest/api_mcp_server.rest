###
# @name create_attachment_text_file
# ツール "create-attachment-text-file" を呼び出し、添付ファイルを作成します(tools/call)
POST {{base_org_url}}/api/{{organization_id}}/workspaces/{{workspace_id}}/mcp
Authorization: Basic {{org-user-id}} {{org-user-pw}}
content-type: application/json

{
  "jsonrpc": "2.0",
  "id": 1,
  "method": "tools/call",
  "params": {
    "name": "create-attachment-text-file",
    "arguments": {
      "filename": "example.txt",
      "text": "Hello Exastro\nCreated by mcp create-attachment-text-file tool\ndatetime=${{$localDatetime iso8601}}",
      "mime_type": "text/plain"
    }
  }
}

###
@create_attachment_text_file_id = {{create_attachment_text_file.response.body.$.result.structuredContent.file_id}}

###
# ツール "get-attachment-text-file" を呼び出し、添付ファイルを取得します(tools/call)
POST {{base_org_url}}/api/{{organization_id}}/workspaces/{{workspace_id}}/mcp
Authorization: Basic {{org-user-id}} {{org-user-pw}}
content-type: application/json

{
  "jsonrpc": "2.0",
  "id": 1,
  "method": "tools/call",
  "params": {
    "name": "get-attachment-text-file",
    "arguments": {
      "file_id": "{{create_attachment_text_file_id}}",
      "encoding": "utf-8"
    }
  }
}

###
# GET "mcp/attachment_file/file_id" を呼び出し、添付ファイルのmatadataを取得します

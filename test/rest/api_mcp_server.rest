###### MCP Server ######

# Global values
# not quate strings
@org-user-id = admin
@org-user-pw = password
@base_org_url = http://platform-auth:{{org-mng-port}}
@organization_id = org1
@workspace_id = ws1


###
# MCPの初期化(initialize)を行う
POST {{base_org_url}}/api/{{organization_id}}/workspaces/{{workspace_id}}/mcp
Authorization: Basic {{org-user-id}} {{org-user-pw}}
content-type: application/json

{
  "jsonrpc": "2.0",
  "method": "initialize",
  "params": {},
  "id": 1
}

